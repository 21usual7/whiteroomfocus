{
  "manifest_version": 3,
  "name": "WHITE ROOM",
  "version": "1.0",
  "description": "Записывает учебные страницы для разбора в WHITE ROOM. Всё хранится локально.",
  "key": "",
  "permissions": [
    "tabs",
    "nativeMessaging",
    "storage",
    "scripting",
    "declarativeNetRequest",
    "alarms"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "WHITE ROOM"
  }
}
